@insert_zone declarations
#ifndef COMBATANT_WORLD_TWEAKS_FOG_UNIFORMS_DECLARED
#define COMBATANT_WORLD_TWEAKS_FOG_UNIFORMS_DECLARED
uniform bool combatantWorldTweaksFogControl;
uniform bool combatantWorldTweaksFogModify;
uniform float combatantWorldTweaksFogStart;
uniform float combatantWorldTweaksFogEnd;
uniform vec3 combatantWorldTweaksFogColor;
uniform int combatantWorldTweaksFogDisableMask;
#endif

vec3 combatantPhotonFogWorkingColor() {
    // WorldTweaks stores UI colors in sRGB/Rec.709. Photon composites fog in
    // linear Rec.2020, so never inject the UI value directly into the HDR scene.
    vec3 c = pow(clamp(combatantWorldTweaksFogColor, vec3(0.0), vec3(1.0)), vec3(2.2));
    return vec3(
        dot(c, vec3(0.62742569, 0.32928911, 0.04335024)),
        dot(c, vec3(0.06902744, 0.91957858, 0.01136138)),
        dot(c, vec3(0.01636642, 0.08802890, 0.89568432))
    );
}

float combatantPhotonFogTransmittance(float distanceToCamera) {
    float fogStart = max(combatantWorldTweaksFogStart, 0.0);
    float fogEnd = max(combatantWorldTweaksFogEnd, fogStart + 1.0);
    float amount = smoothstep(fogStart, fogEnd, max(distanceToCamera, 0.0));
    return 1.0 - amount;
}

bool combatantPhotonSuppressDefaultAirFog() {
    if (!combatantWorldTweaksFogControl || combatantWorldTweaksFogModify) return false;
    #if defined WORLD_OVERWORLD
        return (combatantWorldTweaksFogDisableMask & 200) != 0;
    #elif defined WORLD_NETHER
        return (combatantWorldTweaksFogDisableMask & 16) != 0;
    #elif defined WORLD_END
        return (combatantWorldTweaksFogDisableMask & 32) != 0;
    #else
        return false;
    #endif
}

void combatantPhotonApplyWorldTweaksAirFog(
    inout mat2x3 fog,
    float distanceToCamera,
    bool sky
) {
    if (!combatantWorldTweaksFogControl) return;

    if (combatantWorldTweaksFogModify) {
        // Keep Photon's own atmospheric treatment for the infinite sky/cloud
        // background. Applying a finite-distance UI fog curve to sky pixels is
        // what previously washed the sky and erased clouds.
        if (sky) return;

        float transmittance = combatantPhotonFogTransmittance(distanceToCamera);
        vec3 t = vec3(transmittance);
        fog = mat2x3(combatantPhotonFogWorkingColor() * (1.0 - t), t);
        return;
    }

    if (combatantPhotonSuppressDefaultAirFog()) {
        fog = mat2x3(vec3(0.0), vec3(1.0));
    }
} // combatantPhotonApplyWorldTweaksAirFog

void combatantPhotonApplyWorldTweaksWaterFog(
    inout mat2x3 fog,
    float distanceToCamera
) {
    if (!combatantWorldTweaksFogControl) return;

    // Fog modification has the same precedence as the vanilla WorldTweaks
    // FogEnvironment mixins: explicit custom fog wins over the no-water-fog
    // toggle and is expressed through Photon's scattering/transmittance pair.
    if (combatantWorldTweaksFogModify) {
        float transmittance = combatantPhotonFogTransmittance(distanceToCamera);
        vec3 t = vec3(transmittance);
        fog = mat2x3(combatantPhotonFogWorkingColor() * (1.0 - t), t);
    } else if ((combatantWorldTweaksFogDisableMask & 1) != 0) {
        fog = mat2x3(vec3(0.0), vec3(1.0));
    }
} // combatantPhotonApplyWorldTweaksWaterFog
@end

