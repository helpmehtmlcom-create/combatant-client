        vec3 combatant_light_extent = max(
            combatantCustomLightBoundsMax - combatantCustomLightBoundsMin,
            vec3(1e-4)
        );
        vec3 combatant_light_t = clamp(
            (combatant_world_pos - combatantCustomLightBoundsMin) / combatant_light_extent,
            vec3(0.0), vec3(1.0)
        );
        light_levels = vec2(
            combatant_trilinear_light(
                combatantCustomBlockLightCornersA,
                combatantCustomBlockLightCornersB,
                combatant_light_t
            ),
            combatant_trilinear_light(
                combatantCustomSkyLightCornersA,
                combatantCustomSkyLightCornersB,
                combatant_light_t
            )
        );
        combatant_sky_visibility = combatant_trilinear_light(
            combatantCustomSkyVisibilityCornersA,
            combatantCustomSkyVisibilityCornersB,
            combatant_light_t
        );
        light_levels = max(light_levels, vec2(combatant_fullbright_floor()));
    }
@end

