#if defined(COMBATANT_MSAA_DEFERRED_INPUTS) && !defined(LOD_MOD_ACTIVE)
    if (combatantAaOwner == 1 && combatantMsaaDeferredActive) {
        return combatant_msaa_depth_at(texel);
    }
#endif
    return texelFetch(combined_depth_tex, texel, 0).x;
}

float combatant_msaa_edge_gbuffer0(ivec2 texel) {
