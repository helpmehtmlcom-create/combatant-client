    combatant_sky_visibility = 1.0;

@end

@insert_after_hash fad71d3e91aaddde2d201ec96d096ab4382c998ac8e96a0dc2f43eea9b83a88c
    // Preserve the native path exactly: its lightmap/fullbright values are available before any
    // Photon vertex animation. Imported geometry gets spatial light after its world position is
    // known below.
    if (!combatantCustomGeometry) {
        light_levels = max(light_levels, vec2(combatant_fullbright_floor()));
    }
@end

@insert_after_hash 19aa70534ef810189936a01c97f702052075a7d2927368b3eb039de72991f945
    // Photon declares entity TBN flat because Minecraft meshes are faceted. glTF normals/tangents
    // are smooth. Critically, copy the basis only after get_tbn_matrix() initialized it; the old
    // adapter copied uninitialized tbn immediately after light_levels and produced split normals.
    combatant_smooth_tbn = tbn;
@end

@insert_after_hash 017c0ecec96d975ca45b9882168e6d79a440a43b3e71e92a58611f0f2d500107
    if (combatantCustomGeometry) {
        vec3 combatant_world_pos = scene_pos + cameraPosition;
        vec3 combatant_light_extent = max(
            combatantCustomLightBoundsMax - combatantCustomLightBoundsMin,
            vec3(1e-4)
        );
        vec3 combatant_light_t = clamp(
            (combatant_world_pos - combatantCustomLightBoundsMin) / combatant_light_extent,
            vec3(0.0), vec3(1.0)
        );
        light_levels = vec2(
            combatant_trilinear_light(
                combatantCustomBlockLightCornersA,
                combatantCustomBlockLightCornersB,
                combatant_light_t
            ),
            combatant_trilinear_light(
                combatantCustomSkyLightCornersA,
                combatantCustomSkyLightCornersB,
                combatant_light_t
            )
        );
        combatant_sky_visibility = combatant_trilinear_light(
            combatantCustomSkyVisibilityCornersA,
            combatantCustomSkyVisibilityCornersB,
            combatant_light_t
        );
        light_levels = max(light_levels, vec2(combatant_fullbright_floor()));
    }
@end

