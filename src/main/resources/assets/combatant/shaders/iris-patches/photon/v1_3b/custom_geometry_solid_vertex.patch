@insert_before_function main
float combatant_trilinear_light(vec4 z0, vec4 z1, vec3 t) {
    float y0 = mix(mix(z0.x, z0.y, t.x), mix(z0.z, z0.w, t.x), t.y);
    float y1 = mix(mix(z1.x, z1.y, t.x), mix(z1.z, z1.w, t.x), t.y);
    return mix(y0, y1, t.z);
}

float combatant_fullbright_floor() {
    return max(
        combatantFullbrightEnabled ? clamp(combatantFullbrightMinLight, 0.0, 1.0) : 0.0,
        clamp(combatantOverrideAmbientLight, 0.0, 1.0)
    );
}

@end

@insert_after_function_open main
    // Keep Photon authoritative for entity transforms, TBN construction and projection. Combatant
