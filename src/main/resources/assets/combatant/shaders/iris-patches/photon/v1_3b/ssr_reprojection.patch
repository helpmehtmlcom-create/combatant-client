@insert_before_function trace_specular_ray 1
bool combatantAaSsrStableHitReprojection() {
    // colortex5 is presentation-aligned history when Combatant owns TAA.
    return combatantAaOwner == 2;
}

float combatantAaSsrRayDither(float spatialNoise) {
    // Photon normally rotates the SSR raymarch offset every frame. With an
    // independently resolved TAA history this makes an otherwise static mirror
    // reflection select a different depth hit each frame. Keep the spatial
    // distribution, but remove only the temporal rotation for Combatant TAA.
    return combatantAaOwner == 2 ? spatialNoise : r1(frameCounter, spatialNoise);
}

