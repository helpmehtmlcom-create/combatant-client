#ifndef COMBATANT_FULLBRIGHT_UNIFORMS_DECLARED
#define COMBATANT_FULLBRIGHT_UNIFORMS_DECLARED
uniform bool combatantFullbrightEnabled;
uniform float combatantFullbrightMinLight;
uniform float combatantOverrideAmbientLight;
#endif

vec3 combatant_decode_emission(float packed, out bool unlit) {
    uint bits = uint(round(clamp01(packed) * 65535.0));
    unlit = (bits & 0x8000u) != 0u;
    vec3 encoded = vec3(float(bits & 0xFu), float((bits >> 4u) & 0xFu),
                        float((bits >> 8u) & 0xFu)) * rcp(15.0);
    float scale = exp2(float((bits >> 12u) & 0x7u));
    return encoded * scale;
}

vec4 combatant_fetch_gbuffer0(ivec2 texel) {
    return combatantAaOwner == 1 && combatantMsaaDeferredActive
        ? combatant_msaa_gbuffer0_at(texel)
        : texelFetch(colortex1, texel, 0);
}

vec4 combatant_fetch_gbuffer1(ivec2 texel) {
    return combatantAaOwner == 1 && combatantMsaaDeferredActive
        ? combatant_msaa_gbuffer1_at(texel)
        : texelFetch(colortex2, texel, 0);
}

#if !defined USE_SEPARATE_ENTITY_DRAWS
vec4 combatant_fetch_overlay(ivec2 texel) {
    return combatantAaOwner == 1 && combatantMsaaDeferredActive
        ? combatant_msaa_overlay_at(texel)
        : texelFetch(colortex3, texel, 0);
}
#endif

float combatant_fetch_depth(ivec2 texel) {
#ifdef LOD_MOD_ACTIVE
    // Iris' native LoD combined depth is not owned by the gbuffer FBO capture. Keep its native
    // path rather than sampling an unrelated multisample depth image.
    return texelFetch(combined_depth_tex, texel, 0).x;
#else
    return combatantAaOwner == 1 && combatantMsaaDeferredActive
        ? combatant_msaa_depth_at(texel)
        : texelFetch(combined_depth_tex, texel, 0).x;
#endif
}

@end

