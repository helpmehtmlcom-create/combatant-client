#ifndef COMBATANT_FULLBRIGHT_DEFERRED_UNIFORMS_DECLARED
#define COMBATANT_FULLBRIGHT_DEFERRED_UNIFORMS_DECLARED
uniform bool combatantFullbrightEnabled;
uniform float combatantFullbrightMinLight;
uniform float combatantOverrideAmbientLight;
#endif

vec3 combatant_decode_emission(float packed, out bool unlit) {
    uint bits = uint(round(clamp01(packed) * 65535.0));
    unlit = (bits & 0x8000u) != 0u;
    vec3 encoded = vec3(float(bits & 0xFu), float((bits >> 4u) & 0xFu),
                        float((bits >> 8u) & 0xFu)) * rcp(15.0);
    float scale = exp2(float((bits >> 12u) & 0x7u));
    return encoded * scale;
}

@end

