@insert_before_hash b2d53ab0e633cd17d5acf7007f21012d2e878eea23178e23b721619838e31864
        if (combatant_custom_geometry) {
            // Photon only declares its local gbuffer_data_1 when the pack's
            // NORMAL_MAPPING or SPECULAR_MAPPING option is enabled. Combatant
            // custom materials always populate colortex2, so sample it directly
            // here instead of depending on that compile-time local.
            vec4 combatant_gbuffer_data_1 = texelFetch(colortex2, texel, 0);
            normal = decode_unit_vector(unpack_unorm_2x8(combatant_gbuffer_data_1.x));
            vec2 roughness_metallic = unpack_unorm_2x8(combatant_gbuffer_data_1.y);
            vec2 ao_f0 = unpack_unorm_2x8(combatant_gbuffer_data_1.z);
            vec3 base_material_color = material.albedo;
            material.roughness = max(roughness_metallic.x, 0.002);
            material.f0 = mix(vec3(ao_f0.y), base_material_color, roughness_metallic.y);
            material.albedo = base_material_color * (1.0 - roughness_metallic.y);
            material.is_metal = roughness_metallic.y >= 0.5;
            material.is_hardcoded_metal = false;
            material.f82 = vec3(0.0);
            material.sss_amount = 0.0;
            material.sheen_amount = 0.0; // Canonical glTF has no Photon SSS/sheen channel.
            material.porosity = 0.0;
            material.emission = combatant_decode_emission(combatant_gbuffer_data_1.w, combatant_unlit) *
                rec709_to_rec2020;
            material.ssr_multiplier = step(
                0.01,
                material.f0.x - material.f0.x * material.roughness * SSR_ROUGHNESS_THRESHOLD
            );
            combatant_material_ao = ao_f0.x;
            combatant_unlit_color = base_material_color + material.emission;
        }

@end

