float combatant_translucent_param(int index) {
    uvec4 bytes = uvec4(round(texelFetch(gtexture, ivec2(index, 0), 0) * 255.0));
    uint bits = bytes.r | (bytes.g << 8u) | (bytes.b << 16u) | (bytes.a << 24u);
    return uintBitsToFloat(bits);
}

float combatant_translucent_wrap(float value, float mode) {
    if (mode < 0.5) return clamp(value, 0.0, 1.0);
    if (mode < 1.5) return 1.0 - abs(mod(value, 2.0) - 1.0);
    return fract(value);
}

vec4 combatant_translucent_map(int map_index) {
    int transform_index = 17 + map_index * 6;
    int sampling_index = 47 + map_index * 3;
    vec2 source_uv = combatant_translucent_param(sampling_index) < 0.5 ? uv : combatant_uv1;
    vec2 transformed_uv = vec2(
        dot(vec3(source_uv, 1.0), vec3(combatant_translucent_param(transform_index + 0),
            combatant_translucent_param(transform_index + 1), combatant_translucent_param(transform_index + 2))),
        dot(vec3(source_uv, 1.0), vec3(combatant_translucent_param(transform_index + 3),
            combatant_translucent_param(transform_index + 4), combatant_translucent_param(transform_index + 5)))
    );
    transformed_uv.x = combatant_translucent_wrap(transformed_uv.x, combatant_translucent_param(sampling_index + 1));
    transformed_uv.y = combatant_translucent_wrap(transformed_uv.y, combatant_translucent_param(sampling_index + 2));
    ivec2 atlas_size = textureSize(gtexture, 0);
    float tile_size = float(atlas_size.x / 3);
    vec2 origin = vec2(float(map_index % 3), float(map_index / 3)) * tile_size + vec2(0.0, 1.0);
    return textureLod(gtexture, (origin + vec2(0.5) + transformed_uv * (tile_size - 1.0)) /
        vec2(atlas_size), 0.0);
}

vec3 combatant_translucent_srgb(vec3 value) {
    bvec3 cutoff = lessThanEqual(value, vec3(0.04045));
    return mix(pow((value + 0.055) / 1.055, vec3(2.4)), value / 12.92, cutoff);
}

mat3 combatant_translucent_tbn(mat3 basis) {
    vec3 normal = normalize(basis[2]);
    vec3 tangent = basis[0] - normal * dot(basis[0], normal);
    tangent = normalize(tangent);
    vec3 bitangent = cross(tangent, normal);
    bitangent *= sign(dot(bitangent, basis[1]));
    return mat3(tangent, normalize(bitangent), normal);
}

