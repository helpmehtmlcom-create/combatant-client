@insert_before_function raymarch_depth_buffer
vec2 combatantSsrRasterJitterUv() {
    // Photon applies taa_offset * 0.66 in NDC. Screen UV is half NDC,
    // therefore the raster-space displacement is taa_offset * 0.33.
    return combatantAaOwner == 2 ? taa_offset * 0.33 : vec2(0.0);
}

ivec2 combatantSsrDepthTexel(vec2 stableUv) {
    vec2 sampleUv = stableUv + combatantSsrRasterJitterUv();
    ivec2 depthSize = textureSize(SSRT_DEPTH_SAMPLER, 0);
    ivec2 texel = ivec2(sampleUv * view_res * taau_render_scale);
    return clamp(texel, ivec2(0), depthSize - ivec2(1));
}

float combatantSsrFetchDepth(vec2 stableUv) {
    ivec2 texel = combatantSsrDepthTexel(stableUv);
#if defined(COMBATANT_MSAA_DEFERRED_INPUTS) && !defined(SSRT_LOD) && !defined(LOD_MOD_ACTIVE)
    if (combatantAaOwner == 1 && combatantMsaaDeferredActive) {
        return combatant_msaa_depth_at(texel);
    }
#endif
    return texelFetch(SSRT_DEPTH_SAMPLER, texel, 0).x;
}

@end

@insert_after_function_open raymarch_depth_buffer
    // Object SSR must march in a stable projection when Combatant owns TAA.
    // The depth buffer itself is still raster-jittered, so its lookup is shifted
    // back to the current raster sample in combatantSsrDepthTexel().
    if (combatantAaOwner == 2) {
        screen_pos.xy -= combatantSsrRasterJitterUv();
    }

@end

