@insert_before_hash d04973eb0a2997e8378bd3dfbab167e646f17d6c6afda68a4d30352789b6bc05
    // The refined ray Z is only an approximation of the surface. Once the hit
    // is accepted, reconstruct the reflected object from the actual depth
    // surface so the previous-frame lookup cannot move with the subpixel ray.
    if (combatantAaOwner == 2) {
        ray_pos.z = final_depth;
    }

@end
