{
  "schemaVersion": 1,
  "id": "complementary_reimagined.r5",
  "priority": 500,
  "identity": {
    "family": "complementary_reimagined",
    "policy": "pack_name_and_structural_probes",
    "profile": "complementary_reimagined",
    "packNameRegex": ".*complementary.*reimagined.*"
  },
  "compatibility": {
    "policy": "pack_name_gated_structural_probes",
    "verifiedShaderpackVersions": [
      "r5.6.1"
    ],
    "verifiedMinecraftVersions": [
      "26.2"
    ],
    "verifiedIrisVersions": [
      "1.11.4+mc26.2"
    ],
    "features": [
      "fullbright",
      "worldtweaks_fog",
      "translucent_ssr_fog",
      "underwater_fog",
      "shaderpack_motion_blur_suppression"
    ],
    "notes": "Runtime application is gated by active Iris shaderpack name first, then by structural probes compiled against the loaded expanded GLSL. Patch payload remains Combatant-owned; exact SHA-256 anchors are reserved for dangerous line-level mutations. Stage gating is intentionally not used for expanded include targets; fragment-only composite logic avoids new shaderpack uniforms in declaration payload."
  },
  "integration": {
    "options": {
      "motionBlur": ["MOTION_BLUR_EFFECT", "MOTION_BLURRING_STRENGTH"]
    }
  },
  "targets": [
    {
      "path": "/lib/common.glsl",
      "patch": "common.patch",
      "marker": "COMBATANT_POST_EFFECT_OWNERSHIP"
    },
    {
      "path": "/lib/lighting/mainLighting.glsl",
      "patch": "lighting.patch",
      "marker": "combatantFullbrightStrength"
    },
    {
      "path": "/lib/atmospherics/fog/mainFog.glsl",
      "patch": "fog.patch",
      "marker": "combatantApplyWorldTweaksFog"
    },
    {
      "path": "/program/deferred1.glsl",
      "patch": "deferred1.patch",
      "marker": "combatantApplyWorldTweaksFog(color, lViewPos, z0)"
    },
    {
      "path": "/program/composite1.glsl",
      "patch": "composite1.patch",
      "marker": "combatantComposite1TranslucentFog"
    },
    {
      "path": "/program/composite4.glsl",
      "patch": "composite4.patch",
      "marker": "combatantSuppressShaderpackMotionBlur",
      "ownershipCritical": true
    },
    {
      "path": "/program/gbuffers_water.glsl",
      "patch": "water.patch",
      "marker": "combatantWaterSurfaceFog"
    }
  ]
}
