layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_Texture;
layout(binding = 1) uniform sampler2D u_Mask;
layout(binding = 2, rgba8) writeonly uniform image2D u_Output;

layout(std430, binding = 3) readonly buffer MaskBlurParams {
    vec4 u_TexelRadius; // xy = texel size, z = radius, w = sigma
    vec4 u_Direction;   // xy = direction, z = reject original mask
};

const int LOCAL_EXTENT = 8;
const int MAX_RADIUS = 63;
const int TILE_MAJOR = LOCAL_EXTENT + MAX_RADIUS * 2;
const int TILE_TEXELS = TILE_MAJOR * LOCAL_EXTENT;
shared vec4 s_Tile[TILE_TEXELS];

float gaussian(float x, float sigma) {
    float s = max(sigma, 0.5);
    return exp(-(x * x) / (2.0 * s * s));
}

vec4 fetchPremultiplied(ivec2 pixel, ivec2 sourceSize) {
    vec4 value = texelFetch(u_Texture, clamp(pixel, ivec2(0), sourceSize - ivec2(1)), 0);
    value.rgb *= value.a;
    return value;
}

void main() {
    ivec2 local = ivec2(gl_LocalInvocationID.xy);
    ivec2 groupBase = ivec2(gl_WorkGroupID.xy) * LOCAL_EXTENT;
    ivec2 outputSize = imageSize(u_Output);
    ivec2 sourceSize = max(textureSize(u_Texture, 0), ivec2(1));
    bool vertical = abs(u_Direction.y) > abs(u_Direction.x);

    // One workgroup cooperatively loads the complete Gaussian halo once. At radius 63 this
    // consumes ~17 KiB of shared memory instead of issuing up to 127 texture reads per output.
    int lane = local.y * LOCAL_EXTENT + local.x;
    for (int index = lane; index < TILE_TEXELS; index += LOCAL_EXTENT * LOCAL_EXTENT) {
        int major = index % TILE_MAJOR;
        int minor = index / TILE_MAJOR;
        ivec2 sourcePixel = vertical
                ? groupBase + ivec2(minor, major - MAX_RADIUS)
                : groupBase + ivec2(major - MAX_RADIUS, minor);
        s_Tile[index] = fetchPremultiplied(sourcePixel, sourceSize);
    }
    barrier();

    ivec2 pixel = groupBase + local;
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    if (u_Direction.z > 0.5 && texture(u_Mask, uv).a > 0.0) {
        imageStore(u_Output, pixel, vec4(0.0));
        return;
    }

    int radius = clamp(int(u_TexelRadius.z + 0.5), 0, MAX_RADIUS);
    int major = (vertical ? local.y : local.x) + MAX_RADIUS;
    int minor = vertical ? local.x : local.y;
    int center = minor * TILE_MAJOR + major;

    float weight = gaussian(0.0, u_TexelRadius.w);
    vec4 accum = s_Tile[center] * weight;
    float weightSum = weight;
    for (int i = 1; i <= MAX_RADIUS; ++i) {
        if (i > radius) break;
        weight = gaussian(float(i), u_TexelRadius.w);
        accum += (s_Tile[center - i] + s_Tile[center + i]) * weight;
        weightSum += weight * 2.0;
    }

    vec4 blurred = accum / max(weightSum, 0.0001);
    vec3 rgb = blurred.a > 0.0001 ? blurred.rgb / blurred.a : vec3(0.0);
    imageStore(u_Output, pixel, vec4(rgb, blurred.a));
}
