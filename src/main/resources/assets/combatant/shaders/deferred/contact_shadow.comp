#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_ResolvedDepth;
layout(binding = 1) uniform sampler2D u_DepthPyramid;
layout(binding = 2) uniform sampler2D u_GbufferGeometry;
layout(binding = 3, r8) writeonly uniform image2D u_ContactVisibility;

layout(std430, binding = 4) readonly buffer ContactShadowData {
    mat4 inverseProjection;
    mat4 projection;
    // xy: depth -> NDC, zw: NDC -> depth.
    vec4 depthTransform;
    // xyz: view-space direction from receiver toward directional light; w: max trace distance.
    vec4 lightDirectionAndDistance;
    // x: max steps, y: minimum step, z: step growth, w: hit thickness in view units.
    vec4 traceParams0;
    // x: normal bias, y: edge margin, z: Hi-Z mip step scale.
    vec4 traceParams1;
} u_Contact;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * sign(n.xy);
    return normalize(n);
}

vec3 reconstructView(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Contact.depthTransform.x + u_Contact.depthTransform.y;
    vec4 h = u_Contact.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(h.w) < 1e-7) return vec3(0.0);
    return h.xyz / h.w;
}

bool projectView(vec3 viewPosition, out vec2 uv, out float depth) {
    vec4 clip = u_Contact.projection * vec4(viewPosition, 1.0);
    if (abs(clip.w) < 1e-7 || clip.w <= 0.0) return false;
    vec3 ndc = clip.xyz / clip.w;
    uv = ndc.xy * 0.5 + 0.5;
    depth = ndc.z * u_Contact.depthTransform.z + u_Contact.depthTransform.w;
    return true;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_ContactVisibility);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    float surfaceDepth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (surfaceDepth <= 0.0) {
        imageStore(u_ContactVisibility, pixel, vec4(1.0));
        return;
    }

    vec3 surface = reconstructView(uv, surfaceDepth);
    vec3 normal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 direction = normalize(u_Contact.lightDirectionAndDistance.xyz);
    if (dot(normal, direction) <= 0.0) {
        imageStore(u_ContactVisibility, pixel, vec4(1.0));
        return;
    }

    float maxDistance = u_Contact.lightDirectionAndDistance.w;
    int maxSteps = clamp(int(u_Contact.traceParams0.x + 0.5), 1, 128);
    float stepLength = u_Contact.traceParams0.y;
    float stepGrowth = u_Contact.traceParams0.z;
    float thickness = u_Contact.traceParams0.w;
    float edgeMargin = u_Contact.traceParams1.y;
    float mipStepScale = u_Contact.traceParams1.z;
    vec3 rayPosition = surface + normal * u_Contact.traceParams1.x;
    float travelled = 0.0;
    int mipCount = textureQueryLevels(u_DepthPyramid);
    float visibility = 1.0;

    for (int i = 0; i < 128; ++i) {
        if (i >= maxSteps) break;
        travelled += stepLength;
        if (travelled > maxDistance) break;
        rayPosition += direction * stepLength;
        stepLength *= stepGrowth;

        vec2 rayUv;
        float rayDepth;
        if (!projectView(rayPosition, rayUv, rayDepth)) break;
        if (any(lessThanEqual(rayUv, vec2(edgeMargin)))
                || any(greaterThanEqual(rayUv, vec2(1.0 - edgeMargin)))) break;
        if (rayDepth <= 0.0 || rayDepth > 1.0) continue;

        float mip = clamp(
                floor(log2(1.0 + float(i) * mipStepScale)),
                0.0,
                float(max(0, mipCount - 1))
        );
        float nearestDepth = textureLod(u_DepthPyramid, rayUv, mip).r;
        // Reversed-Z: if even the nearest depth in the tile is behind the ray point, skip it.
        if (nearestDepth <= rayDepth) continue;

        float exactDepth = textureLod(u_ResolvedDepth, rayUv, 0.0).r;
        if (exactDepth <= 0.0 || exactDepth <= rayDepth) continue;
        vec3 scenePosition = reconstructView(rayUv, exactDepth);
        if (abs(scenePosition.z - rayPosition.z) <= thickness) {
            visibility = 0.0;
            break;
        }
    }

    imageStore(u_ContactVisibility, pixel, vec4(visibility));
}
