#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_ReflectionColor;
layout(binding = 1, rgba16f) writeonly uniform image2D u_HistoryReflection;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_HistoryReflection);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    imageStore(u_HistoryReflection, pixel, textureLod(u_ReflectionColor, uv, 0.0));
}
