#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_CascadeVisibility;
layout(binding = 1) uniform sampler2D u_ContactVisibility;
layout(binding = 2, r8) writeonly uniform image2D u_ShadowVisibility;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_ShadowVisibility);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);

    // Source-level composition only. Filtering/softness/intensity belong to later quality/art passes.
    float cascade = textureLod(u_CascadeVisibility, uv, 0.0).r;
    float contact = textureLod(u_ContactVisibility, uv, 0.0).r;
    imageStore(u_ShadowVisibility, pixel, vec4(min(cascade, contact)));
}
