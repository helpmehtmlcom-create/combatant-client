layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_SkyDiffuseIrradiance;
layout(binding = 1, rgba16f) writeonly uniform image2D u_EnvironmentIrradiance;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_EnvironmentIrradiance);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec3 sky = max(textureLod(u_SkyDiffuseIrradiance, uv, 0.0).rgb, vec3(0.0));

    // Stable combination boundary. Future neutral producers (colored block-light volume, probes)
    // add incoming irradiance here without changing the deferred BRDF consumer.
    imageStore(u_EnvironmentIrradiance, pixel, vec4(sky, 1.0));
}
