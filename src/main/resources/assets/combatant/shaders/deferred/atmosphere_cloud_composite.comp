#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_BaseRadiance;
layout(binding = 1) uniform sampler2D u_Depth;
layout(binding = 2) uniform sampler2D u_CloudRadiance;
layout(binding = 3) uniform sampler2D u_CloudDepth;
layout(binding = 4, rgba16f) readonly uniform image3D u_IntegratedRadiance;
layout(binding = 5, rgba16f) readonly uniform image3D u_IntegratedTransmittance;
layout(binding = 6, rgba16f) writeonly uniform image2D u_Output;
layout(std430, binding = 7) readonly buffer AtmosphereCompositeData {
    mat4 inverseProjection;
    vec4 froxel;
    vec4 policy;
} u_Data;

#moj_import <combatant:deferred_froxel_transport.glsl>

struct MediaTransport {
    vec3 radiance;
    vec3 transmittance;
};

vec3 viewPosition(vec2 uv, float depth) {
    float ndcZ = u_Data.policy.y > 0.5 ? depth : depth * 2.0 - 1.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    return view.xyz / max(abs(view.w), 1e-7) * sign(view.w);
}

void sampleCloudDepthAware(vec2 uv, float sceneDistance, out vec4 cloud, out float cloudDistance) {
    ivec2 size = textureSize(u_CloudRadiance, 0);
    vec2 position = uv * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 f = fract(position);

    ivec2 coords[4] = ivec2[4](
        base,
        base + ivec2(1, 0),
        base + ivec2(0, 1),
        base + ivec2(1, 1)
    );
    float bilinear[4] = float[4](
        (1.0 - f.x) * (1.0 - f.y),
        f.x * (1.0 - f.y),
        (1.0 - f.x) * f.y,
        f.x * f.y
    );

    float referenceDepth = 1e30;
    bool hasVisible = false;
    for (int i = 0; i < 4; ++i) {
        ivec2 sampleCoord = clamp(coords[i], ivec2(0), size - ivec2(1));
        float d = texelFetch(u_CloudDepth, sampleCoord, 0).r;
        bool visible = d >= 0.0 && (sceneDistance < 0.0 || d < sceneDistance);
        if (visible) {
            hasVisible = true;
            referenceDepth = min(referenceDepth, d);
        }
    }
    if (!hasVisible) {
        cloud = vec4(0.0, 0.0, 0.0, 1.0);
        cloudDistance = -1.0;
        return;
    }

    vec4 accumulated = vec4(0.0);
    float accumulatedDepth = 0.0;
    float weightSum = 0.0;
    float depthScale = max(12.0, referenceDepth * 0.06);
    for (int i = 0; i < 4; ++i) {
        ivec2 sampleCoord = clamp(coords[i], ivec2(0), size - ivec2(1));
        float d = texelFetch(u_CloudDepth, sampleCoord, 0).r;
        bool visible = d >= 0.0 && (sceneDistance < 0.0 || d < sceneDistance);
        if (!visible) continue;
        float depthWeight = exp(-abs(d - referenceDepth) / depthScale);
        float weight = bilinear[i] * depthWeight;
        accumulated += texelFetch(u_CloudRadiance, sampleCoord, 0) * weight;
        accumulatedDepth += d * weight;
        weightSum += weight;
    }

    if (weightSum <= 1e-6) {
        ivec2 nearestCoord = clamp(ivec2(round(position)), ivec2(0), size - ivec2(1));
        cloud = texelFetch(u_CloudRadiance, nearestCoord, 0);
        cloudDistance = texelFetch(u_CloudDepth, nearestCoord, 0).r;
        if (cloudDistance < 0.0 || (sceneDistance >= 0.0 && cloudDistance >= sceneDistance)) {
            cloud = vec4(0.0, 0.0, 0.0, 1.0);
            cloudDistance = -1.0;
        }
        return;
    }

    cloud = accumulated / weightSum;
    cloudDistance = accumulatedDepth / weightSum;
}

MediaTransport identityTransport() {
    MediaTransport result;
    result.radiance = vec3(0.0);
    result.transmittance = vec3(1.0);
    return result;
}

MediaTransport fetchBoundary(ivec2 cell, int slice) {
    ivec3 dimensions = imageSize(u_IntegratedRadiance);
    if (slice < 0) return identityTransport();
    slice = clamp(slice, 0, dimensions.z - 1);
    cell = clamp(cell, ivec2(0), dimensions.xy - ivec2(1));
    vec4 radiance = imageLoad(u_IntegratedRadiance, ivec3(cell, slice));
    vec4 transmittance = imageLoad(u_IntegratedTransmittance, ivec3(cell, slice));
    MediaTransport result;
    result.radiance = max(radiance.rgb, vec3(0.0));
    result.transmittance = clamp(transmittance.rgb, vec3(0.0), vec3(1.0));
    return result;
}

MediaTransport sampleColumn(ivec2 cell, float distanceBlocks) {
    ivec3 dimensions = imageSize(u_IntegratedRadiance);
    float maxDistance = max(u_Data.froxel.w, 1e-4);
    float exponentValue = max(u_Data.policy.x, 1.0);
    float distance01 = clamp(distanceBlocks / maxDistance, 0.0, 1.0);
    float boundary = pow(distance01, 1.0 / exponentValue) * float(dimensions.z);
    float coordinate = boundary - 1.0;
    int lower = int(floor(coordinate));
    int upper = lower + 1;
    float fractionValue = fract(coordinate);

    MediaTransport a = fetchBoundary(cell, lower);
    MediaTransport b = fetchBoundary(cell, upper);
    MediaTransport result;
    result.radiance = mix(a.radiance, b.radiance, fractionValue);
    result.transmittance = mix(a.transmittance, b.transmittance, fractionValue);
    return result;
}

MediaTransport sampleTransport(vec2 uv, float distanceBlocks) {
    ivec2 dimensions = imageSize(u_IntegratedRadiance).xy;
    vec2 position = uv * vec2(dimensions) - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 f = fract(position);

    MediaTransport a = sampleColumn(base, distanceBlocks);
    MediaTransport b = sampleColumn(base + ivec2(1, 0), distanceBlocks);
    MediaTransport c = sampleColumn(base + ivec2(0, 1), distanceBlocks);
    MediaTransport d = sampleColumn(base + ivec2(1, 1), distanceBlocks);

    MediaTransport result;
    result.radiance = mix(mix(a.radiance, b.radiance, f.x), mix(c.radiance, d.radiance, f.x), f.y);
    result.transmittance = mix(mix(a.transmittance, b.transmittance, f.x),
                               mix(c.transmittance, d.transmittance, f.x), f.y);
    return result;
}

MediaTransport segmentBetween(MediaTransport nearTransport, MediaTransport farTransport) {
    vec3 safeNearT = max(nearTransport.transmittance, vec3(1e-5));
    MediaTransport result;
    result.transmittance = clamp(farTransport.transmittance / safeNearT, vec3(0.0), vec3(1.0));
    result.radiance = max((farTransport.radiance - nearTransport.radiance) / safeNearT, vec3(0.0));
    return result;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Output);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 base = max(textureLod(u_BaseRadiance, uv, 0.0).rgb, vec3(0.0));
    float depth = textureLod(u_Depth, uv, 0.0).r;
    float sceneDistance = depth > 0.0 ? length(viewPosition(uv, depth)) : -1.0;
    float backgroundDistance = sceneDistance >= 0.0
            ? min(sceneDistance, u_Data.froxel.w)
            : u_Data.froxel.w;

    vec4 cloud;
    float cloudDistance;
    sampleCloudDepthAware(uv, sceneDistance, cloud, cloudDistance);

    if (sceneDistance < 0.0) {
        vec3 result = base;
        if (cloudDistance >= 0.0 && cloudDistance <= backgroundDistance) {
            float effectiveCloudDistance = clamp(cloudDistance, 0.0, backgroundDistance);
            MediaTransport frontTransport = sampleTransport(uv, effectiveCloudDistance);
            vec3 safeFrontT = max(frontTransport.transmittance, vec3(1e-5));
            vec3 skyBehindCloud = max((base - frontTransport.radiance) / safeFrontT, vec3(0.0));
            float cloudT = clamp(cloud.a, 0.0, 1.0);
            vec3 cloudAtCamera = max(cloud.rgb, vec3(0.0)) + cloudT * skyBehindCloud;
            result = frontTransport.radiance + frontTransport.transmittance * cloudAtCamera;
        }
        imageStore(u_Output, pixel, vec4(max(result, vec3(0.0)), 1.0));
        return;
    }

    MediaTransport backgroundTransport = sampleTransport(uv, backgroundDistance);
    vec3 result = backgroundTransport.radiance + backgroundTransport.transmittance * base;
    if (cloudDistance >= 0.0 && cloudDistance <= backgroundDistance) {
        float effectiveCloudDistance = clamp(cloudDistance, 0.0, backgroundDistance);
        MediaTransport frontTransport = sampleTransport(uv, effectiveCloudDistance);
        MediaTransport behindTransport = segmentBetween(frontTransport, backgroundTransport);
        vec3 backgroundAtCloud = behindTransport.radiance + behindTransport.transmittance * base;
        float cloudT = clamp(cloud.a, 0.0, 1.0);
        vec3 cloudAtCamera = max(cloud.rgb, vec3(0.0)) + cloudT * backgroundAtCloud;
        result = frontTransport.radiance + frontTransport.transmittance * cloudAtCamera;
    }

    imageStore(u_Output, pixel, vec4(max(result, vec3(0.0)), 1.0));
}
