#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_BaseRadiance;
layout(binding = 1) uniform sampler2D u_Depth;
layout(binding = 2) uniform sampler2D u_SkyRadiance;
layout(binding = 3, rgba16f) writeonly uniform image2D u_Output;
layout(std430, binding = 4) readonly buffer SkyCompositeData {
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 flags;
} u_Data;
layout(std430, binding = 5) readonly buffer SkyEnvironmentState {
    vec4 state0;
    vec4 state1;
} u_SkyState;

const float PI = 3.14159265358979323846;

vec2 latLongFromDirection(vec3 d) {
    d = normalize(d);
    float phi = atan(d.z, d.x);
    float theta = acos(clamp(d.y, -1.0, 1.0));
    return vec2(phi / (2.0 * PI) + 0.5, theta / PI);
}

vec3 worldRay(vec2 uv) {
    // Any finite clip-space depth on the perspective ray gives the same normalized direction.
    float ndcZ = u_Data.flags.x > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    vec3 viewDirection = normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
    return normalize(mat3(u_Data.inverseView) * viewDirection);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Output);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 base = textureLod(u_BaseRadiance, uv, 0.0).rgb;
    float depth = textureLod(u_Depth, uv, 0.0).r;
    bool validSky = u_SkyState.state0.x > 0.5;
    if (depth <= 0.0 && validSky) {
        base = max(textureLod(u_SkyRadiance, latLongFromDirection(worldRay(uv)), 0.0).rgb, vec3(0.0));
    }
    imageStore(u_Output, pixel, vec4(base, 1.0));
}
