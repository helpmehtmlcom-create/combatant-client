layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_SceneColor;
layout(binding = 1) uniform sampler2D u_GbufferGeometry;
layout(binding = 2) uniform sampler2D u_ResolvedDepth;
layout(binding = 3) uniform sampler2D u_DepthPyramid;
layout(binding = 4, rgba16f) writeonly uniform image2D u_ReflectionTrace;
layout(binding = 5, r8) writeonly uniform image2D u_ReflectionConfidence;

layout(std430, binding = 6) readonly buffer ReflectionTraceData {
    mat4 inverseProjection;
    mat4 inverseView;
    mat4 projection;
    // xy: depth -> NDC, zw: NDC -> depth.
    vec4 depthTransform;
    // xy: full-resolution extent, z: camera far, w: trace max-distance scale.
    vec4 traceExtentAndFar;
    // x: max steps, y: minimum step, z: view-depth step scale, w: step growth.
    vec4 traceParams0;
    // x: hit thickness, y: normal bias, z: edge margin, w: Hi-Z mip step scale.
    vec4 traceParams1;
} u_Trace;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) {
        n.xy = (1.0 - abs(n.yx)) * sign(n.xy);
    }
    return normalize(n);
}

vec3 reconstructView(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Trace.depthTransform.x + u_Trace.depthTransform.y;
    vec4 h = u_Trace.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    return h.xyz / max(abs(h.w), 1e-7) * sign(h.w);
}

bool projectView(vec3 viewPosition, out vec2 uv, out float depth) {
    vec4 clip = u_Trace.projection * vec4(viewPosition, 1.0);
    if (abs(clip.w) < 1e-7) return false;
    vec3 ndc = clip.xyz / clip.w;
    uv = ndc.xy * 0.5 + 0.5;
    depth = ndc.z * u_Trace.depthTransform.z + u_Trace.depthTransform.w;
    return clip.w > 0.0;
}

void storeMiss(ivec2 pixel) {
    imageStore(u_ReflectionTrace, pixel, vec4(0.0));
    imageStore(u_ReflectionConfidence, pixel, vec4(0.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_ReflectionTrace);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    float surfaceDepth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (surfaceDepth <= 0.0) {
        storeMiss(pixel);
        return;
    }

    vec3 viewPosition = reconstructView(uv, surfaceDepth);
    vec3 viewNormal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);
    vec3 incident = normalize(viewPosition);
    vec3 rayDirection = normalize(reflect(incident, viewNormal));

    if (dot(rayDirection, viewNormal) <= 0.0) {
        storeMiss(pixel);
        return;
    }

    float normalBias = u_Trace.traceParams1.y;
    vec3 rayPosition = viewPosition + viewNormal * normalBias;
    float stepLength = max(u_Trace.traceParams0.y, abs(viewPosition.z) * u_Trace.traceParams0.z);
    float maxDistance = max(1.0, u_Trace.traceExtentAndFar.z * u_Trace.traceExtentAndFar.w);
    float stepGrowth = u_Trace.traceParams0.w;
    float thickness = u_Trace.traceParams1.x;
    float edgeMargin = u_Trace.traceParams1.z;
    float mipStepScale = u_Trace.traceParams1.w;
    int maxSteps = clamp(int(u_Trace.traceParams0.x + 0.5), 1, 256);
    float travelled = 0.0;
    int mipCount = textureQueryLevels(u_DepthPyramid);
    vec2 hitUv = vec2(-1.0);

    for (int stepIndex = 0; stepIndex < 256; ++stepIndex) {
        if (stepIndex >= maxSteps) break;
        travelled += stepLength;
        if (travelled > maxDistance) break;
        rayPosition += rayDirection * stepLength;
        stepLength *= stepGrowth;

        vec2 rayUv;
        float rayDepth;
        if (!projectView(rayPosition, rayUv, rayDepth)) break;
        if (any(lessThanEqual(rayUv, vec2(edgeMargin)))
                || any(greaterThanEqual(rayUv, vec2(1.0 - edgeMargin)))) break;
        if (rayDepth <= 0.0 || rayDepth > 1.0) continue;

        float mip = clamp(
                floor(log2(1.0 + float(stepIndex) * mipStepScale)),
                0.0,
                float(max(0, mipCount - 1))
        );
        float nearestDepth = textureLod(u_DepthPyramid, rayUv, mip).r;
        if (nearestDepth <= 0.0) continue;

        // Reversed-Z: lower depth means farther away. Crossing the nearest stored depth means the
        // ray entered geometry. Confirm against mip 0 before publishing a screen-space hit.
        if (rayDepth <= nearestDepth + thickness) {
            float fullDepth = textureLod(u_ResolvedDepth, rayUv, 0.0).r;
            if (fullDepth > 0.0 && rayDepth <= fullDepth + thickness) {
                hitUv = rayUv;
                break;
            }
        }
    }

    if (hitUv.x < 0.0) {
        storeMiss(pixel);
        return;
    }

    vec3 reflected = textureLod(u_SceneColor, hitUv, 0.0).rgb;
    imageStore(u_ReflectionTrace, pixel, vec4(reflected, 1.0));
    imageStore(u_ReflectionConfidence, pixel, vec4(1.0, 0.0, 0.0, 0.0));
}
