layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_ResolvedDepth;
layout(binding = 1) uniform sampler2D u_DepthPyramid;
layout(binding = 2) uniform sampler2D u_GbufferGeometry;
layout(binding = 3) uniform sampler2D u_GbufferDepth;
layout(binding = 4, r8) writeonly uniform image2D u_AmbientVisibility;
layout(binding = 5, rgba16f) writeonly uniform image2D u_BentNormal;

layout(std430, binding = 6) readonly buffer AmbientOcclusionData {
    mat4 inverseProjection;
    mat4 projection;
    vec4 depthTransform;
    // x: total horizon sample budget, y: view-space radius, z: view-space thickness, w: mip bias.
    vec4 params0;
    // x: max Hi-Z mip (0 = mip 0 only), yz: full-resolution extent.
    vec4 params1;
} u_Ao;

const float PI = 3.14159265358979323846;
const float HALF_PI = 1.57079632679489661923;

vec3 decodeOctahedral(vec2 encoded) {
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 reconstructView(vec2 uv, float depth) {
    vec2 ndcXY = uv * 2.0 - 1.0;
    float ndcZ = depth * u_Ao.depthTransform.x + u_Ao.depthTransform.y;
    vec4 h = u_Ao.inverseProjection * vec4(ndcXY, ndcZ, 1.0);
    if (abs(h.w) < 1e-7) return vec3(0.0);
    return h.xyz / h.w;
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float sampleHorizonCos(vec2 sampleUv,
                       float mip,
                       vec3 center,
                       vec3 viewVector,
                       float radius,
                       float thickness,
                       float baseline) {
    float sampleDepth = textureLod(u_DepthPyramid, sampleUv, mip).r;
    if (sampleDepth <= 0.0) return baseline;

    vec3 samplePosition = reconstructView(sampleUv, sampleDepth);
    vec3 horizonVector = samplePosition - center;
    float distanceValue = length(horizonVector);
    if (distanceValue <= 1e-5 || distanceValue > radius + thickness) return baseline;

    float horizonCos = dot(horizonVector / distanceValue, viewVector);
    float effectiveDistance = max(0.0, distanceValue - thickness);
    float attenuation = 1.0 - clamp(effectiveDistance / max(radius, 1e-4), 0.0, 1.0);
    attenuation *= attenuation;
    return mix(baseline, horizonCos, attenuation);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_AmbientVisibility);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(outputSize);
    float centerDepth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    float gbufferDepth = textureLod(u_GbufferDepth, uv, 0.0).r;
    float depthTolerance = max(1.0e-6, abs(gbufferDepth) * 1.0e-5);
    bool ownsPixel = centerDepth > 0.0 && gbufferDepth > 0.0
            && abs(centerDepth - gbufferDepth) <= depthTolerance;
    if (!ownsPixel) {
        imageStore(u_AmbientVisibility, pixel, vec4(1.0));
        imageStore(u_BentNormal, pixel, vec4(0.0, 0.0, 1.0, 1.0));
        return;
    }
    vec3 normal = decodeOctahedral(textureLod(u_GbufferGeometry, uv, 0.0).rg);

    vec3 center = reconstructView(uv, centerDepth);
    vec3 viewVector = normalize(-center);
    float radius = max(u_Ao.params0.y, 1e-4);
    float thickness = max(u_Ao.params0.z, 0.0);
    float mipBias = u_Ao.params0.w;
    int sampleBudget = clamp(int(u_Ao.params0.x + 0.5), 4, 64);
    int sliceCount = clamp((sampleBudget + 3) / 4, 2, 8);
    int stepsPerSide = clamp(sampleBudget / max(2 * sliceCount, 1), 1, 4);
    int availableMips = textureQueryLevels(u_DepthPyramid);
    int maxMip = min(max(0, int(u_Ao.params1.x + 0.5)), max(0, availableMips - 1));

    float projectedRadiusPixels = abs(u_Ao.projection[1][1]) * radius
            / max(0.05, -center.z) * 0.5 * float(outputSize.y);
    projectedRadiusPixels = max(projectedRadiusPixels, 1.0);

    float rotation = hash12(vec2(pixel)) * PI;
    float visibilitySum = 0.0;
    vec3 bentSum = normal * 1e-3;
    float bentWeight = 1e-3;

    for (int slice = 0; slice < 8; ++slice) {
        if (slice >= sliceCount) break;

        float phi = rotation + (float(slice) + 0.5) * PI / float(sliceCount);
        vec2 screenDirection = vec2(cos(phi), sin(phi));
        vec3 directionVector = vec3(screenDirection, 0.0);
        vec3 orthoDirection = directionVector - viewVector * dot(directionVector, viewVector);
        float orthoLength = length(orthoDirection);
        if (orthoLength <= 1e-5) continue;
        orthoDirection /= orthoLength;

        vec3 axis = normalize(cross(orthoDirection, viewVector));
        vec3 projectedNormal = normal - axis * dot(normal, axis);
        float projectedNormalLength = length(projectedNormal);
        if (projectedNormalLength <= 1e-5) continue;
        projectedNormal /= projectedNormalLength;

        float signNormal = dot(orthoDirection, projectedNormal) < 0.0 ? -1.0 : 1.0;
        float cosNormal = clamp(dot(projectedNormal, viewVector), -1.0, 1.0);
        float normalAngle = signNormal * acos(cosNormal);

        float lowHorizon0 = cos(normalAngle + HALF_PI);
        float lowHorizon1 = cos(normalAngle - HALF_PI);
        float horizonCos0 = lowHorizon0;
        float horizonCos1 = lowHorizon1;

        for (int step = 0; step < 4; ++step) {
            if (step >= stepsPerSide) break;
            float stepFraction = (float(step) + 0.5) / float(stepsPerSide);
            float stepPixels = max(1.0, projectedRadiusPixels * stepFraction * stepFraction);
            float mip = clamp(floor(log2(stepPixels)) + mipBias, 0.0, float(maxMip));
            vec2 uvStep = screenDirection * stepPixels / vec2(outputSize);

            vec2 uv0 = uv - uvStep;
            if (all(greaterThan(uv0, vec2(0.0))) && all(lessThan(uv0, vec2(1.0)))) {
                horizonCos0 = max(horizonCos0, sampleHorizonCos(
                        uv0, mip, center, viewVector, radius, thickness, lowHorizon0));
            }

            vec2 uv1 = uv + uvStep;
            if (all(greaterThan(uv1, vec2(0.0))) && all(lessThan(uv1, vec2(1.0)))) {
                horizonCos1 = max(horizonCos1, sampleHorizonCos(
                        uv1, mip, center, viewVector, radius, thickness, lowHorizon1));
            }
        }

        float horizon0 = -acos(clamp(horizonCos0, -1.0, 1.0));
        float horizon1 = acos(clamp(horizonCos1, -1.0, 1.0));
        horizon0 = normalAngle + max(horizon0 - normalAngle, -HALF_PI);
        horizon1 = normalAngle + min(horizon1 - normalAngle, HALF_PI);

        float sinNormal = sin(normalAngle);
        float integral0 = (cosNormal + 2.0 * horizon0 * sinNormal
                - cos(2.0 * horizon0 - normalAngle)) * 0.25;
        float integral1 = (cosNormal + 2.0 * horizon1 * sinNormal
                - cos(2.0 * horizon1 - normalAngle)) * 0.25;
        float sliceVisibility = clamp(projectedNormalLength * (integral0 + integral1), 0.0, 1.0);
        visibilitySum += sliceVisibility;

        float bentAngle = clamp(0.5 * (horizon0 + horizon1), -HALF_PI, HALF_PI);
        vec3 sliceBent = normalize(viewVector * cos(bentAngle) + orthoDirection * sin(bentAngle));
        float hemisphere = max(dot(sliceBent, normal), 0.0);
        float weight = sliceVisibility * hemisphere;
        bentSum += sliceBent * weight;
        bentWeight += weight;
    }

    float visibility = clamp(visibilitySum / float(sliceCount), 0.0, 1.0);
    vec3 bentNormal = bentWeight > 1e-5 ? normalize(bentSum / bentWeight) : normal;
    if (dot(bentNormal, normal) < 0.0) bentNormal = normal;

    imageStore(u_AmbientVisibility, pixel, vec4(visibility));
    imageStore(u_BentNormal, pixel, vec4(bentNormal, 1.0));
}
