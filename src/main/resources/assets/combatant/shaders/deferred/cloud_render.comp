#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D u_SkyRadiance;
layout(binding = 6) uniform sampler2D u_ResolvedDepth;
layout(binding = 1, rgba16f) writeonly uniform image2D u_CloudRadiance;
layout(binding = 2, r32f) writeonly uniform image2D u_CloudDepth;
layout(binding = 7, rg16f) writeonly uniform image2D u_CloudFlow;

layout(std430, binding = 3) readonly buffer CloudRenderData {
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 cameraTime;
    vec4 grid;
    vec4 counts;
    vec4 quality;
    vec4 sunDirection;
    vec4 sunRadiance;
    vec4 noiseDomain;
    vec4 lightingPolicy;
} u_Data;

const float PI = 3.14159265358979323846;
const int MAX_PRIMARY_STEPS = 192;
const int MAX_LIGHT_STEPS = 8;

vec2 latLongFromDirection(vec3 d) {
    d = normalize(d);
    float phi = atan(d.z, d.x);
    float theta = acos(clamp(d.y, -1.0, 1.0));
    return vec2(phi / (2.0 * PI) + 0.5, theta / PI);
}

vec3 worldRay(vec2 uv) {
    float ndcZ = u_Data.counts.z > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    vec3 viewDirection = normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
    return normalize(mat3(u_Data.inverseView) * viewDirection);
}

float sceneDistance(vec2 uv) {
    float depth = textureLod(u_ResolvedDepth, uv, 0.0).r;
    if (depth <= 0.0) return -1.0;
    float ndcZ = u_Data.counts.z > 0.5 ? depth : depth * 2.0 - 1.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    if (abs(view.w) < 1e-7) return -1.0;
    return length(view.xyz / view.w);
}

#define COMBATANT_CLOUD_WEATHER_BINDING 4
#define COMBATANT_CLOUD_LAYER_BINDING 5
#moj_import <combatant:deferred_cloud_density.glsl>

bool layerBounds(vec3 ray, out float startT, out float endT) {
    float minY = 1e20;
    float maxY = -1e20;
    int layerCount = clamp(int(u_Data.counts.x), 0, COMBATANT_CLOUD_MAX_LAYERS);
    for (int i = 0; i < COMBATANT_CLOUD_MAX_LAYERS; ++i) {
        if (i >= layerCount) break;
        minY = min(minY, u_Layers.layers[i].altitudeDensity.x);
        maxY = max(maxY, u_Layers.layers[i].altitudeDensity.y);
    }
    if (layerCount == 0 || maxY <= minY) return false;

    float cameraY = u_Data.cameraTime.y;
    if (abs(ray.y) < 1e-5) {
        if (cameraY < minY || cameraY > maxY) return false;
        startT = 0.0;
        endT = u_Data.counts.y;
        return endT > startT;
    }
    float a = (minY - cameraY) / ray.y;
    float b = (maxY - cameraY) / ray.y;
    startT = max(0.0, min(a, b));
    endT = min(u_Data.counts.y, max(a, b));
    return endT > startT;
}

float hgPhase(float cosTheta, float g) {
    float g2 = g * g;
    float denominator = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return (1.0 - g2) / (4.0 * PI * denominator * sqrt(denominator));
}

float lightTransmittance(vec3 localPosition, vec3 lightDirection, int stepCount) {
    if (stepCount <= 0) return 1.0;
    float opticalDepth = 0.0;
    float stepLength = max(u_Data.lightingPolicy.y, 0.25);
    for (int i = 0; i < MAX_LIGHT_STEPS; ++i) {
        if (i >= stepCount) break;
        vec3 p = localPosition + lightDirection * (float(i) + 1.0) * stepLength;
        float extinction;
        float anisotropy;
        float density = combatant_cloud_density_at(p, extinction, anisotropy);
        opticalDepth += density * extinction * stepLength;
    }
    return exp(-min(opticalDepth, 20.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_CloudRadiance);
    if (any(greaterThanEqual(pixel, size))) return;

    if (u_Data.counts.w <= 0.5 || u_Data.counts.x < 0.5 || u_Data.grid.w < 0.5) {
        imageStore(u_CloudRadiance, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(u_CloudDepth, pixel, vec4(-1.0, 0.0, 0.0, 0.0));
        imageStore(u_CloudFlow, pixel, vec4(0.0));
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 ray = worldRay(uv);
    float startT;
    float endT;
    if (!layerBounds(ray, startT, endT)) {
        imageStore(u_CloudRadiance, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(u_CloudDepth, pixel, vec4(-1.0, 0.0, 0.0, 0.0));
        imageStore(u_CloudFlow, pixel, vec4(0.0));
        return;
    }
    float opaqueDistance = sceneDistance(uv);
    if (opaqueDistance >= 0.0) endT = min(endT, opaqueDistance);
    if (endT <= startT) {
        imageStore(u_CloudRadiance, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(u_CloudDepth, pixel, vec4(-1.0, 0.0, 0.0, 0.0));
        imageStore(u_CloudFlow, pixel, vec4(0.0));
        return;
    }

    int requestedSteps = clamp(int(u_Data.quality.x), 8, MAX_PRIMARY_STEPS);
    int lightSteps = clamp(int(u_Data.quality.y), 0, MAX_LIGHT_STEPS);
    float maxStepLength = max(u_Data.quality.z, 0.25);
    int distanceSteps = int(ceil((endT - startT) / maxStepLength));
    int primarySteps = clamp(max(requestedSteps, distanceSteps), 8, MAX_PRIMARY_STEPS);
    float stepLength = max((endT - startT) / float(primarySteps), 0.25);
    vec3 radiance = vec3(0.0);
    float transmittance = 1.0;
    vec3 cameraLocalPosition = vec3(u_Data.cameraTime.x, u_Data.cameraTime.y, u_Data.cameraTime.z);
    float cameraExtinction;
    float cameraAnisotropy;
    float cameraDensity = startT <= 1e-4
            ? combatant_cloud_density_at(cameraLocalPosition, cameraExtinction, cameraAnisotropy)
            : 0.0;
    float firstDepth = cameraDensity > 1e-5 && cameraExtinction > 0.0 ? 0.0 : -1.0;
    vec2 firstFlow = firstDepth == 0.0 ? combatant_cloud_sample_weather(cameraLocalPosition.xz).windFront.xy : vec2(0.0);
    vec3 sunDirection = normalize(u_Data.sunDirection.xyz);
    vec3 skyAmbient = max(textureLod(u_SkyRadiance, latLongFromDirection(vec3(0.0, 1.0, 0.0)), 0.0).rgb, vec3(0.0));
    float jitter = fract(combatant_cloud_hash31(vec3(vec2(pixel), u_Data.quality.w * 257.0)) + u_Data.quality.w);

    for (int i = 0; i < MAX_PRIMARY_STEPS; ++i) {
        if (i >= primarySteps || transmittance < 0.01) break;
        float t = startT + (float(i) + jitter) * stepLength;
        if (t > endT) break;
        vec3 localPosition = cameraLocalPosition + ray * t;
        float extinction;
        float anisotropy;
        float density = combatant_cloud_density_at(localPosition, extinction, anisotropy);
        if (density <= 1e-5 || extinction <= 0.0) continue;
        if (firstDepth < 0.0) {
            firstDepth = t;
            firstFlow = combatant_cloud_sample_weather(localPosition.xz).windFront.xy;
        }

        float sigmaT = density * extinction;
        float segmentT = exp(-sigmaT * stepLength);
        vec3 source = skyAmbient * max(u_Data.lightingPolicy.x, 0.0);
        if (u_Data.sunDirection.w > 0.5) {
            float lightT = lightTransmittance(localPosition, sunDirection, lightSteps);
            float phase = hgPhase(dot(ray, sunDirection), anisotropy);
            source += max(u_Data.sunRadiance.rgb, vec3(0.0)) * lightT * phase;
        }
        float integrated = (1.0 - segmentT) / max(sigmaT, 1e-5);
        radiance += transmittance * source * sigmaT * integrated;
        transmittance *= segmentT;
    }

    imageStore(u_CloudRadiance, pixel, vec4(max(radiance, vec3(0.0)), clamp(transmittance, 0.0, 1.0)));
    imageStore(u_CloudDepth, pixel, vec4(firstDepth, 0.0, 0.0, 0.0));
    imageStore(u_CloudFlow, pixel, vec4(firstFlow, 0.0, 0.0));
}
