#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(binding = 1, rgba16f) writeonly uniform image3D u_SegmentRadiance;
layout(binding = 2, rgba16f) writeonly uniform image3D u_SegmentTransmittance;
layout(binding = 3) uniform sampler2D u_AerialRadiance;
layout(binding = 4) uniform sampler2D u_AerialTransmittance;
layout(binding = 7) uniform sampler2D u_CloudShadowMap;

layout(std430, binding = 0) readonly buffer FroxelMediaData {
    mat4 inverseProjection;
    mat4 inverseView;
    vec4 cameraTime;
    vec4 grid;
    vec4 counts;
    vec4 noiseDomain;
    vec4 froxel;
    vec4 policy;
    vec4 shadowMapDomain;
    vec4 shadowSun;
    vec4 cloudBounds;
    vec4 aerialLayout;
} u_Data;

const float PI = 3.14159265358979323846;

#define COMBATANT_CLOUD_WEATHER_BINDING 5
#define COMBATANT_CLOUD_LAYER_BINDING 6
#moj_import <combatant:deferred_cloud_density.glsl>
#moj_import <combatant:deferred_froxel_transport.glsl>
#moj_import <combatant:deferred_cloud_shadow_sampling.glsl>

vec3 worldRay(vec2 uv) {
    float ndcZ = u_Data.policy.y > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    vec3 viewDirection = normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
    return normalize(mat3(u_Data.inverseView) * viewDirection);
}

vec4 aerialTexel(sampler2D source, int azimuthIndex, int zenithIndex, int distanceIndex) {
    ivec2 size = textureSize(source, 0);
    int zenithCount = max(1, int(u_Data.aerialLayout.x));
    int azimuthCount = max(1, int(u_Data.aerialLayout.y));
    azimuthIndex = (azimuthIndex % azimuthCount + azimuthCount) % azimuthCount;
    zenithIndex = clamp(zenithIndex, 0, zenithCount - 1);
    distanceIndex = clamp(distanceIndex, 0, max(size.y - 1, 0));
    int x = azimuthIndex * zenithCount + zenithIndex;
    return texelFetch(source, ivec2(clamp(x, 0, max(size.x - 1, 0)), distanceIndex), 0);
}

vec4 sampleAerial(sampler2D source, vec3 direction, float distanceKm) {
    direction = normalize(direction);
    int zenithCount = max(1, int(u_Data.aerialLayout.x));
    int azimuthCount = max(1, int(u_Data.aerialLayout.y));
    float zenithCoord = clamp(direction.y * 0.5 + 0.5, 0.0, 1.0) * float(zenithCount) - 0.5;
    float azimuth01 = fract(atan(direction.z, direction.x) / (2.0 * PI) + 1.0);
    float azimuthCoord = azimuth01 * float(azimuthCount) - 0.5;
    float distance01 = sqrt(clamp(distanceKm / max(u_Data.aerialLayout.z, 1e-4), 0.0, 1.0));
    ivec2 aerialSize = textureSize(source, 0);
    float distanceCoord = distance01 * float(aerialSize.y) - 0.5;

    int z0 = int(floor(zenithCoord));
    int a0 = int(floor(azimuthCoord));
    int d0 = int(floor(distanceCoord));
    float zf = fract(zenithCoord);
    float af = fract(azimuthCoord);
    float df = fract(distanceCoord);

    vec4 c000 = aerialTexel(source, a0, z0, d0);
    vec4 c100 = aerialTexel(source, a0 + 1, z0, d0);
    vec4 c010 = aerialTexel(source, a0, z0 + 1, d0);
    vec4 c110 = aerialTexel(source, a0 + 1, z0 + 1, d0);
    vec4 c001 = aerialTexel(source, a0, z0, d0 + 1);
    vec4 c101 = aerialTexel(source, a0 + 1, z0, d0 + 1);
    vec4 c011 = aerialTexel(source, a0, z0 + 1, d0 + 1);
    vec4 c111 = aerialTexel(source, a0 + 1, z0 + 1, d0 + 1);

    vec4 near0 = mix(mix(c000, c100, af), mix(c010, c110, af), zf);
    vec4 far0 = mix(mix(c001, c101, af), mix(c011, c111, af), zf);
    return mix(near0, far0, df);
}

void cumulativeAtmosphere(vec3 ray, float distanceBlocks, out vec3 radiance, out vec3 transmittance) {
    if (u_Data.policy.z <= 0.5 || distanceBlocks <= 0.0) {
        radiance = vec3(0.0);
        transmittance = vec3(1.0);
        return;
    }
    float distanceKm = distanceBlocks * 0.001;
    radiance = max(sampleAerial(u_AerialRadiance, ray, distanceKm).rgb, vec3(0.0));
    transmittance = clamp(sampleAerial(u_AerialTransmittance, ray, distanceKm).rgb, vec3(0.0), vec3(1.0));
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 dimensions = imageSize(u_SegmentRadiance);
    if (any(greaterThanEqual(coord, dimensions))) return;

    vec2 uv = (vec2(coord.xy) + 0.5) / vec2(dimensions.xy);
    vec3 ray = worldRay(uv);
    float nearDistance = combatant_froxel_boundary_distance(
            coord.z, dimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float farDistance = combatant_froxel_boundary_distance(
            coord.z + 1, dimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float centerDistance = 0.5 * (nearDistance + farDistance);
    float segmentLength = max(farDistance - nearDistance, 1e-4);

    vec3 nearRadiance;
    vec3 nearTransmittance;
    vec3 farRadiance;
    vec3 farTransmittance;
    cumulativeAtmosphere(ray, nearDistance, nearRadiance, nearTransmittance);
    cumulativeAtmosphere(ray, farDistance, farRadiance, farTransmittance);

    vec3 safeNearT = max(nearTransmittance, vec3(1e-5));
    vec3 segmentTransmittance = clamp(farTransmittance / safeNearT, vec3(0.0), vec3(1.0));
    vec3 segmentRadiance = max((farRadiance - nearRadiance) / safeNearT, vec3(0.0));

    vec3 relativeWorld = ray * centerDistance;
    float worldY = u_Data.cameraTime.y + relativeWorld.y;
    float shadowVisibility = combatant_sample_cloud_shadow(
            u_CloudShadowMap, relativeWorld, worldY,
            u_Data.shadowMapDomain, u_Data.shadowSun, u_Data.cloudBounds);
    segmentRadiance *= shadowVisibility;

    float cloudSigmaT = 0.0;
    float cloudSigmaS = 0.0;
    if (u_Data.counts.w > 0.5) {
        vec3 cameraLocal = u_Data.cameraTime.xyz;
        CloudOptics cloud = combatant_cloud_optics_at(cameraLocal + relativeWorld);
        cloudSigmaT = max(0.0, cloud.density * cloud.extinction);
        cloudSigmaS = cloudSigmaT * clamp(cloud.albedo, 0.0, 1.0);

        float localCloudT = exp(-cloudSigmaT * segmentLength * 0.5);
        segmentRadiance *= localCloudT;
    }

    imageStore(u_SegmentRadiance, coord, vec4(segmentRadiance, cloudSigmaT));
    imageStore(u_SegmentTransmittance, coord, vec4(segmentTransmittance, cloudSigmaS));
}
