#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(binding = 1, rgba16f) writeonly uniform image3D u_SegmentRadiance;
layout(binding = 2, rgba16f) writeonly uniform image3D u_SegmentTransmittance;
layout(binding = 3) uniform sampler2D u_AerialRadiance;
layout(binding = 4) uniform sampler2D u_AerialTransmittance;
layout(binding = 7) uniform sampler2D u_CloudShadowMap;
layout(binding = 11, rgba16f) writeonly uniform image3D u_MediaProperties;

#moj_import <combatant:deferred_froxel_media_data.glsl>


#define COMBATANT_CLOUD_WEATHER_BINDING 5
#define COMBATANT_CLOUD_LAYER_BINDING 6
#moj_import <combatant:deferred_cloud_density.glsl>
#moj_import <combatant:deferred_froxel_transport.glsl>
#moj_import <combatant:deferred_cloud_shadow_sampling.glsl>

vec3 worldRay(vec2 uv) {
    float ndcZ = u_Data.policy.y > 0.5 ? 0.5 : 0.0;
    vec4 view = u_Data.inverseProjection * vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
    vec3 viewDirection = normalize(view.xyz / max(abs(view.w), 1e-7) * sign(view.w));
    return normalize(mat3(u_Data.inverseView) * viewDirection);
}

#moj_import <combatant:deferred_aerial_sampling.glsl>

void cumulativeAtmosphere(vec3 ray, float distanceBlocks, out vec3 radiance, out vec3 transmittance) {
    if (u_Data.policy.z <= 0.5 || distanceBlocks <= 0.0) {
        radiance = vec3(0.0);
        transmittance = vec3(1.0);
        return;
    }
    float distanceKm = distanceBlocks * 0.001;
    radiance = max(combatant_sample_aerial(u_AerialRadiance, ray, distanceKm).rgb, vec3(0.0));
    transmittance = clamp(combatant_sample_aerial(u_AerialTransmittance, ray, distanceKm).rgb, vec3(0.0), vec3(1.0));
}

float mediumWeatherFieldWeight(vec2 localXZ) {
    int width = max(0, int(u_Data.grid.y));
    int depth = max(0, int(u_Data.grid.z));
    if (width <= 0 || depth <= 0 || u_Data.grid.w <= 0.5) return 0.0;

    float spacing = max(u_Data.grid.x, 1.0);
    vec2 maximum = vec2(float(max(width - 1, 0)), float(max(depth - 1, 0))) * spacing;
    vec2 enter = smoothstep(vec2(-spacing), vec2(0.0), localXZ);
    vec2 leave = vec2(1.0) - smoothstep(maximum, maximum + vec2(spacing), localXZ);
    return clamp(enter.x * enter.y * leave.x * leave.y, 0.0, 1.0);
}

vec3 mediumWeatherSignals(vec2 localXZ) {
    vec3 globalSignals = u_Data.mediumWeatherState.w > 0.5
            ? max(u_Data.mediumWeatherState.xyz, vec3(0.0))
            : vec3(0.0);
    WeatherCell localWeather = combatant_cloud_sample_weather(localXZ);
    vec3 localSignals = vec3(
            max(localWeather.climate.x, 0.0),
            max(localWeather.climate.z, 0.0),
            max(localWeather.climate.w, 0.0)
    );
    float localWeight = mediumWeatherFieldWeight(localXZ) * clamp(localWeather.windFront.w, 0.0, 1.0);
    return mix(globalSignals, localSignals, localWeight);
}

float mediumDensity(vec3 localPosition, float distanceBlocks) {
    if (u_Data.mediumDistribution.w <= 0.5 || distanceBlocks > u_Data.mediumLighting.z) return 0.0;

    vec3 weatherSignals = mediumWeatherSignals(localPosition.xz);
    float humidityThreshold = clamp(u_Data.mediumWeather.x, 0.0, 0.9999);
    float humidityDrive = max(weatherSignals.x - humidityThreshold, 0.0)
            / max(1.0 - humidityThreshold, 1e-4);
    float weatherDensity = u_Data.mediumDistribution.z
            + humidityDrive * u_Data.mediumWeather.y
            + weatherSignals.z * u_Data.mediumWeather.z
            + weatherSignals.y * u_Data.mediumWeather.w;

    float heightAboveReference = max(localPosition.y - u_Data.mediumDistribution.x, 0.0);
    float heightScale = exp(-heightAboveReference / max(u_Data.mediumDistribution.y, 1e-3));
    return max(0.0, weatherDensity * heightScale);
}

float equivalentEmission(float integratedRadiance, float transmittance, float segmentLength) {
    float t = clamp(transmittance, 1e-6, 1.0);
    float sigma = -log(t) / max(segmentLength, 1e-5);
    float oneMinusT = 1.0 - t;
    if (sigma <= 1e-6 || oneMinusT <= 1e-6) {
        return max(integratedRadiance, 0.0) / max(segmentLength, 1e-5);
    }
    return max(integratedRadiance, 0.0) * sigma / oneMinusT;
}

void mergeAtmosphereAndMedium(vec3 atmosphereRadiance,
                              vec3 atmosphereTransmittance,
                              vec3 mediumExtinction,
                              float segmentLength,
                              out vec3 radiance,
                              out vec3 transmittance) {
    vec3 atmosphereSigma = -log(clamp(atmosphereTransmittance, vec3(1e-6), vec3(1.0)))
            / max(segmentLength, 1e-5);
    vec3 atmosphereEmission = vec3(
            equivalentEmission(atmosphereRadiance.r, atmosphereTransmittance.r, segmentLength),
            equivalentEmission(atmosphereRadiance.g, atmosphereTransmittance.g, segmentLength),
            equivalentEmission(atmosphereRadiance.b, atmosphereTransmittance.b, segmentLength)
    );
    vec3 totalSigma = max(atmosphereSigma + max(mediumExtinction, vec3(0.0)), vec3(0.0));
    transmittance = exp(-totalSigma * segmentLength);
    vec3 factor = vec3(segmentLength);
    for (int channel = 0; channel < 3; ++channel) {
        if (totalSigma[channel] > 1e-6) {
            factor[channel] = (1.0 - transmittance[channel]) / totalSigma[channel];
        }
    }
    radiance = atmosphereEmission * factor;
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 dimensions = imageSize(u_SegmentRadiance);
    if (any(greaterThanEqual(coord, dimensions))) return;

    vec2 uv = (vec2(coord.xy) + 0.5) / vec2(dimensions.xy);
    vec3 ray = worldRay(uv);
    float nearDistance = combatant_froxel_boundary_distance(
            coord.z, dimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float farDistance = combatant_froxel_boundary_distance(
            coord.z + 1, dimensions.z, u_Data.froxel.w, u_Data.policy.x);
    float centerDistance = 0.5 * (nearDistance + farDistance);
    float segmentLength = max(farDistance - nearDistance, 1e-4);

    vec3 nearRadiance;
    vec3 nearTransmittance;
    vec3 farRadiance;
    vec3 farTransmittance;
    cumulativeAtmosphere(ray, nearDistance, nearRadiance, nearTransmittance);
    cumulativeAtmosphere(ray, farDistance, farRadiance, farTransmittance);

    vec3 safeNearT = max(nearTransmittance, vec3(1e-5));
    vec3 atmosphereSegmentT = clamp(farTransmittance / safeNearT, vec3(0.0), vec3(1.0));
    vec3 atmosphereSegmentL = max((farRadiance - nearRadiance) / safeNearT, vec3(0.0));

    vec3 relativeWorld = ray * centerDistance;
    vec3 localPosition = vec3(u_Data.cameraTime.x, u_Data.cameraTime.y, u_Data.cameraTime.z) + relativeWorld;
    float density = mediumDensity(localPosition, centerDistance);
    vec3 sigmaS = max(u_Data.mediumScattering.rgb, vec3(0.0)) * density;
    vec3 sigmaA = max(u_Data.mediumAbsorption.rgb, vec3(0.0)) * density;
    vec3 sigmaT = sigmaS + sigmaA;

    vec3 segmentRadiance;
    vec3 segmentTransmittance;
    mergeAtmosphereAndMedium(atmosphereSegmentL, atmosphereSegmentT, sigmaT,
            segmentLength, segmentRadiance, segmentTransmittance);

    float worldY = localPosition.y;
    float shadowVisibility = combatant_sample_cloud_shadow(
            u_CloudShadowMap, relativeWorld, worldY,
            u_Data.shadowMapDomain, u_Data.shadowSun, u_Data.cloudBounds);
    segmentRadiance *= shadowVisibility;

    float cloudSigmaT = 0.0;
    float cloudSigmaS = 0.0;
    if (u_Data.counts.w > 0.5) {
        CloudOptics cloud = combatant_cloud_optics_at(localPosition);
        cloudSigmaT = max(0.0, cloud.density * cloud.extinction);
        cloudSigmaS = cloudSigmaT * clamp(cloud.albedo, 0.0, 1.0);
        segmentRadiance *= exp(-cloudSigmaT * segmentLength * 0.5);
    }

    imageStore(u_SegmentRadiance, coord, vec4(segmentRadiance, cloudSigmaT));
    imageStore(u_SegmentTransmittance, coord, vec4(segmentTransmittance, cloudSigmaS));
    imageStore(u_MediaProperties, coord, vec4(sigmaS, clamp(u_Data.mediumScattering.w, -0.95, 0.95)));
}
